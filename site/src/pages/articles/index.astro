---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";

const allArticles = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const articlesWithAuthors = await Promise.all(
  allArticles.map(async (article) => {
    const authorEntry = await getEntry("team", article.data.author);
    return {
      article,
      authorName: authorEntry?.data.name ?? article.data.author,
    };
  })
);

const topics = [
  ...new Set(
    allArticles
      .map((a) => a.data.pillarKeyword)
      .filter((topic): topic is string => Boolean(topic))
  ),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title={`Articles — ${SITE_NAME}`}
  description={`Browse all published articles from ${SITE_NAME}. Practical guides with clear authorship, sources, and structured data.`}
  canonicalPath="/articles/"
>
  <section aria-labelledby="articles-heading" class="section-space">
    <div class="container-site">
      <h1 id="articles-heading" class="mb-8">Articles</h1>

      <form
        id="articles-filters"
        class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end"
        role="search"
      >
        <div class="min-w-0 flex-1">
          <label for="articles-search" class="mb-2 block text-small text-muted">
            Search by title
          </label>
          <input
            id="articles-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Search articles…"
            class="min-h-11 w-full rounded-btn border border-border bg-white px-3 text-small text-heading placeholder:text-muted"
          />
        </div>
        <div class="w-full sm:w-64">
          <label for="articles-topic" class="mb-2 block text-small text-muted">
            Topic
          </label>
          <select
            id="articles-topic"
            name="topic"
            class="min-h-11 w-full rounded-btn border border-border bg-white px-3 text-small text-heading"
          >
            <option value="">All topics</option>
            {
              topics.map((topic) => (
                <option value={topic}>{topic}</option>
              ))
            }
          </select>
        </div>
      </form>

      <p id="articles-empty" class="mb-0 text-small text-muted" hidden>
        No articles match your filters.
      </p>

      <ul
        id="articles-grid"
        class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          articlesWithAuthors.map(({ article, authorName }) => (
            <li
              data-title={article.data.title.toLowerCase()}
              data-topic={article.data.pillarKeyword ?? ""}
            >
              <a
                href={`/articles/${article.data.slug}/`}
                class="card group flex h-full flex-col overflow-hidden p-0 no-underline transition-colors hover:border-accent/40 hover:no-underline"
              >
                <div class="article-hero-frame">
                  <Image
                    src={article.data.image}
                    alt={article.data.imageAlt}
                    width={600}
                    height={315}
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <span class="mb-3 block text-h4 font-light text-heading group-hover:text-accent">
                    {article.data.title}
                  </span>
                  <p class="mt-auto mb-0 text-small text-muted">
                    <time datetime={article.data.date.toISOString()}>
                      {article.data.date.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                    <span aria-hidden="true"> · </span>
                    <span>{authorName}</span>
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script>
    const form = document.getElementById("articles-filters");
    const searchInput = document.getElementById("articles-search");
    const topicSelect = document.getElementById("articles-topic");
    const emptyMessage = document.getElementById("articles-empty");
    const grid = document.getElementById("articles-grid");

    if (
      form instanceof HTMLFormElement &&
      searchInput instanceof HTMLInputElement &&
      topicSelect instanceof HTMLSelectElement &&
      emptyMessage instanceof HTMLElement &&
      grid instanceof HTMLElement
    ) {
      const items = [...grid.querySelectorAll<HTMLElement>(":scope > li")];

      const applyFilters = () => {
        const query = searchInput.value.trim().toLowerCase();
        const topic = topicSelect.value;
        let visibleCount = 0;

        for (const item of items) {
          const title = item.dataset.title ?? "";
          const itemTopic = item.dataset.topic ?? "";
          const matchesSearch = !query || title.includes(query);
          const matchesTopic = !topic || itemTopic === topic;
          const show = matchesSearch && matchesTopic;
          item.hidden = !show;
          if (show) visibleCount += 1;
        }

        emptyMessage.hidden = visibleCount > 0;
      };

      const syncFromParams = () => {
        const params = new URLSearchParams(window.location.search);
        searchInput.value = params.get("q") ?? "";
        const topic = params.get("topic") ?? "";
        topicSelect.value = [...topicSelect.options].some((o) => o.value === topic)
          ? topic
          : "";
        applyFilters();
      };

      const writeParams = () => {
        const params = new URLSearchParams();
        const query = searchInput.value.trim();
        const topic = topicSelect.value;
        if (query) params.set("q", query);
        if (topic) params.set("topic", topic);
        const next = params.toString();
        const url = next
          ? `${window.location.pathname}?${next}`
          : window.location.pathname;
        window.history.replaceState({}, "", url);
      };

      searchInput.addEventListener("input", () => {
        writeParams();
        applyFilters();
      });
      topicSelect.addEventListener("change", () => {
        writeParams();
        applyFilters();
      });
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        writeParams();
        applyFilters();
      });

      syncFromParams();
    }
  </script>
</BaseLayout>
