---
interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props;
---

<section aria-labelledby="sources-heading" class="mt-12 border-t border-border pt-10">
  <h2 id="sources-heading" class="mb-5 text-h3">Sources / Further reading</h2>
  <ul class="m-0 list-none space-y-3 p-0">
    {
      links.map((link) => (
        <li>
          <a
            href={link.url}
            rel="noopener noreferrer"
            target="_blank"
            class="tap-target inline-flex items-center gap-2 text-content text-accent no-underline hover:underline"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-muted"
              aria-hidden="true"
            >
              <path d="M15 3h6v6"></path>
              <path d="M10 14 21 3"></path>
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            </svg>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
