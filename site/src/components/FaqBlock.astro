---
import FaqAccordion from "./FaqAccordion.astro";

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<section aria-labelledby="faq-heading" class="mt-12 border-t border-border pt-10">
  <h2 id="faq-heading" class="mb-6 text-h3">Frequently asked questions</h2>
  <FaqAccordion faqs={faqs} />
</section>
