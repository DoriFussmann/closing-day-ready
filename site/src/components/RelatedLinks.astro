---
interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props;
---

<section aria-labelledby="related-heading" class="mt-12 border-t border-border pt-10">
  <h2 id="related-heading" class="mb-5 text-h3">Related</h2>
  <ul class="m-0 list-none space-y-2 p-0">
    {
      links.map((link) => (
        <li>
          <a
            href={link.url}
            class="tap-target inline-flex items-center gap-2 text-content text-accent no-underline hover:underline"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-muted"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
