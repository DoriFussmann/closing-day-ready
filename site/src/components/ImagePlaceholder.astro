---
interface Props {
  label: string;
  class?: string;
  aspect?: "hero" | "section" | "square";
}

const { label, class: className = "", aspect = "section" } = Astro.props;

const aspectClass =
  aspect === "hero"
    ? "aspect-[4/3] md:aspect-[5/4]"
    : aspect === "square"
      ? "aspect-square"
      : "aspect-[16/10]";
---

<div
  class:list={[
    "flex items-center justify-center rounded-card border border-dashed border-border bg-surface px-4 py-6 text-center",
    aspectClass,
    className,
  ]}
  role="img"
  aria-label={label}
>
  <p class="m-0 max-w-sm text-small font-normal text-muted">{label}</p>
</div>
