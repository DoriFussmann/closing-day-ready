---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  author: CollectionEntry<"team">;
}

const { author } = Astro.props;
const data = author.data;
---

<aside
  aria-labelledby="author-bio-heading"
  class="mt-12 rounded-card border border-border bg-surface p-6 md:p-8"
>
  <h2 id="author-bio-heading" class="mb-6 text-h3">About the author</h2>
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
    <Image
      src={data.photo}
      alt={`Photo of ${data.name}`}
      width={160}
      height={160}
      loading="lazy"
      class="h-20 w-20 shrink-0 rounded-full object-cover sm:h-[7.5rem] sm:w-[7.5rem]"
    />
    <div class="min-w-0 flex-1">
      <p class="m-0 text-body">
        <a
          href={`/team/#${data.slug}`}
          class="font-normal text-heading no-underline hover:text-accent hover:underline"
        >
          {data.name}
        </a>
        <span class="text-muted"> — {data.role}</span>
      </p>
      {data.credentials && <p class="mt-2 text-small text-muted">{data.credentials}</p>}
      <p class="mt-3 text-content text-body">{data.bio}</p>
      {
        data.sameAs && data.sameAs.length > 0 && (
          <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
            {data.sameAs.map((url) => (
              <li>
                <a
                  href={url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="break-all text-small text-accent"
                >
                  {url}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</aside>
