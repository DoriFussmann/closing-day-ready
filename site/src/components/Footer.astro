---
import { SITE_NAME } from "../config/site";

const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/services/", label: "Services" },
  { href: "/articles/", label: "Articles" },
  { href: "/team/", label: "Team" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy Policy" },
  { href: "/terms/", label: "Terms of Service" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="mt-auto border-t border-border bg-surface">
  <div class="container-site flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <p class="m-0 text-small text-muted">
      <small class="text-small">&copy; {new Date().getFullYear()} {SITE_NAME}</small>
    </p>
    <nav aria-label="Footer">
      <ul class="m-0 flex list-none flex-wrap gap-1 p-0">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="tap-target inline-flex items-center px-3 py-2 text-small text-muted no-underline hover:text-heading hover:no-underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
