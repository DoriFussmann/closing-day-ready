---
import { SITE_NAME } from "../config/site";

const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/services/", label: "Services" },
  { href: "/articles/", label: "Articles" },
  { href: "/team/", label: "Team" },
  { href: "/contact/", label: "Contact" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-border bg-background">
  <div class="container-site">
    <nav class="relative flex items-center justify-between gap-4 py-3" aria-label="Primary">
      <a
        href="/"
        class="tap-target text-small font-semibold text-heading no-underline hover:text-accent hover:no-underline"
      >
        {SITE_NAME}
      </a>

      {/* CSS-only mobile menu — no client hydration */}
      <input id="nav-toggle" type="checkbox" class="peer sr-only" />
      <label
        for="nav-toggle"
        class="tap-target flex cursor-pointer items-center justify-center rounded-btn border border-border px-3 text-small text-heading md:hidden"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </label>

      <ul
        class="absolute left-0 right-0 top-full hidden flex-col gap-1 border-b border-border bg-background px-4 py-3 peer-checked:flex md:static md:flex md:flex-row md:items-center md:gap-1 md:border-0 md:bg-transparent md:p-0"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "tap-target block rounded-btn px-3 py-2 text-small no-underline hover:bg-surface hover:no-underline md:inline-flex",
                  isActive(link.href)
                    ? "font-normal text-heading"
                    : "text-muted hover:text-heading",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
