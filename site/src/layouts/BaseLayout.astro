---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, SITE_URL, SAME_AS } from "../config/site";
import { absoluteUrl, resolveCanonical } from "../lib/url";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  canonical?: string;
  robots?: string;
  locale?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Asset ImageMetadata or already-resolved absolute URL string */
  ogImage?: ImageMetadata | string;
  twitterCard?: string;
  schemaType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  canonical,
  robots = "index, follow",
  locale = "en-US",
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage,
  twitterCard = "summary_large_image",
  jsonLd = [],
} = Astro.props;

if (!title) throw new Error("BaseLayout requires a unique title prop");
if (!description) throw new Error("BaseLayout requires a unique description prop");

const resolvedTitle = title;
const resolvedDescription = description;
const resolvedOgTitle = ogTitle || resolvedTitle;
const resolvedOgDescription = ogDescription || resolvedDescription;
const canonicalHref = resolveCanonical(canonical, canonicalPath);

let ogImageUrl: string | undefined;
if (typeof ogImage === "string" && ogImage) {
  ogImageUrl = /^https?:\/\//i.test(ogImage) ? ogImage : absoluteUrl(ogImage);
} else if (ogImage && typeof ogImage === "object") {
  const optimized = await getImage({ src: ogImage, format: "jpg" });
  const src = optimized.src;
  ogImageUrl = /^https?:\/\//i.test(src) ? src : new URL(src, SITE_URL).href;
}

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: absoluteUrl("/"),
  sameAs: SAME_AS,
};

const allJsonLd = [
  organizationLd,
  ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
].filter(Boolean);
---

<!doctype html>
<html lang={locale.split("-")[0] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content={locale} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={`${SITE_URL.replace(/\/+$/, "")}/rss.xml`} />

    {allJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-btn focus:bg-accent focus:px-4 focus:py-2 focus:text-white focus:no-underline"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
